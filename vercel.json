{
  "headers": [
    {
      "source": "/carga.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/gourmet-feriados",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/caja-sync",
      "schedule": "41 9 * * *"
    },
    {
      "path": "/api/caja-pedidos",
      "schedule": "5 16 * * 1-5"
    }
  ]
}
